{
  "name": "zotero-putongdoc",
  "type": "module",
  "version": "0.2.0",
  "description": "PutongDoc PDF translation plugin for Zotero.",
  "keywords": [
    "zotero",
    "putongdoc",
    "plugin",
    "pdf-translation",
    "translation"
  ],
  "config": {
    "addonName": "PutongDoc",
    "addonID": "zotero-putongdoc@lemos1235",
    "addonRef": "putongdoc",
    "addonInstance": "PutongDoc",
    "prefsPrefix": "extensions.zotero.putongdoc",
    "xpiName": "zotero-putongdoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemos1235/zotero-putongdoc.git"
  },
  "author": "lemos1235",
  "bugs": {
    "url": "https://github.com/lemos1235/zotero-putongdoc/issues"
  },
  "homepage": "https://github.com/lemos1235/zotero-putongdoc#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "test": "node --test tests/*.test.mjs",
    "build": "zotero-plugin build && tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs",
    "build:dev": "zotero-plugin build --dev && tsc --noEmit",
    "format": "prettier --write .",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/bluebird": "^3.5.42",
    "@types/node": "^22.13.13",
    "@types/react": "^19.1.3",
    "epubjs": "^0.3.93",
    "eslint": "^9.23.0",
    "pdfjs-dist": "^5.2.133",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "zotero-plugin-scaffold": "^0.4.1",
    "zotero-types": "4.1.0-beta.1"
  }
}
